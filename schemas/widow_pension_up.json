  "rules": [
    {
      "id": "min_age",
      "type": "min",
      "field": "age",
      "value": 18,
      "label": {
        "en": "Age below 18",
        "hi": "उम्र 18 से कम"
      },
      "message": {
        "hi": "आपकी उम्र {age} साल बताई गई है। इस पेंशन के लिए 18 साल होना ज़रूरी है। क्या उम्र सही है?"
      }
    },
    {
      "id": "name_match",
      "type": "name_match",
      "a": "name",
      "b": "bank_account_name",
      "message": {
        "hi": "आधार पर नाम {name} है, लेकिन पासबुक पर {bank_account_name}। पोर्टल पर दोनों बिल्कुल एक जैसे होने चाहिए। आधार वाला नाम सही है?"
      },
      "message_different": {
        "hi": "आधार पर नाम {name} है, लेकिन पासबुक पर {bank_account_name}। ये दो अलग नाम लगते हैं। क्या यह आपका अपना बैंक खाता है?"
      },
      "label": {
        "en": "Name mismatch detected",
        "hi": "नाम मेल नहीं खाता"
      },
      "detail": {
        "en": "Portal spelling: {name_latin} vs {bank_account_name_latin}. Portals reject names that don't match exactly."
      }
    },
    {
      "id": "death_certificate",
      "type": "must_be_true",
      "field": "has_death_certificate",
      "label": {
        "en": "Death certificate missing",
        "hi": "मृत्यु प्रमाण पत्र नहीं"
      },
      "message": {
        "hi": "मृत्यु प्रमाण पत्र के बिना आवेदन रुक सकता है। पंचायत या नगर पालिका से बनवाया जा सकता है। क्या घर पर कोई कॉपी है?"
      }
    }
