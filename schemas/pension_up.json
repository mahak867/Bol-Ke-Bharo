{
  "form_id": "pension_up",
  "title": {
    "hi": "वृद्धावस्था पेंशन आवेदन",
    "en": "Old-age pension application"
  },
  "note": "Demo schema. Field list and rules must be checked against the real portal and CSC operators before relying on them.",
  "fields": [
    {
      "key": "name",
      "type": "string",
      "required": true,
      "label": {
        "en": "Applicant name (as on Aadhaar)",
        "hi": "आवेदक का नाम (आधार के अनुसार)"
      },
      "ask": {
        "hi": "आपका पूरा नाम क्या है, जैसा आधार कार्ड पर लिखा है?"
      },
      "readback": {
        "hi": "आपका नाम {value} है।"
      }
    },
    {
      "key": "guardian_name",
      "type": "string",
      "required": true,
      "label": {
        "en": "Father's / husband's name",
        "hi": "पिता / पति का नाम"
      },
      "ask": {
        "hi": "आपके पिताजी या पति का नाम क्या है?"
      },
      "readback": {
        "hi": "पिता या पति का नाम {value} है।"
      }
    },
    {
      "key": "age",
      "type": "int",
      "required": true,
      "label": {
        "en": "Age (years)",
        "hi": "उम्र (साल)"
      },
      "ask": {
        "hi": "आपकी उम्र कितने साल है?"
      },
      "readback": {
        "hi": "आपकी उम्र {value} साल है।"
      }
    },
    {
      "key": "gender",
      "type": "enum",
      "options": [
        "female",
        "male",
        "other"
      ],
      "required": true,
      "label": {
        "en": "Gender",
        "hi": "लिंग"
      },
      "ask": {
        "hi": "आप महिला हैं या पुरुष?"
      },
      "readback": {
        "hi": "लिंग: {value}।"
      }
    },
    {
      "key": "district",
      "type": "string",
      "required": true,
      "label": {
        "en": "District",
        "hi": "ज़िला"
      },
      "ask": {
        "hi": "आप किस ज़िले में रहते हैं?"
      },
      "readback": {
        "hi": "ज़िला {value} है।"
      }
    },
    {
      "key": "village",
      "type": "string",
      "required": true,
      "label": {
        "en": "Village / ward",
        "hi": "गाँव / वार्ड"
      },
      "ask": {
        "hi": "आपके गाँव या मोहल्ले का नाम क्या है?"
      },
      "readback": {
        "hi": "गाँव {value} है।"
      }
    },
    {
      "key": "mobile",
      "type": "string",
      "pattern": "^[6-9]\\d{9}$",
      "required": true,
      "label": {
        "en": "Mobile number",
        "hi": "मोबाइल नंबर"
      },
      "ask": {
        "hi": "आपका मोबाइल नंबर बताइए।"
      },
      "readback": {
        "hi": "मोबाइल नंबर {value} है।"
      }
    },
    {
      "key": "aadhaar_last4",
      "type": "string",
      "pattern": "^\\d{4}$",
      "required": true,
      "sensitive": true,
      "label": {
        "en": "Aadhaar (last 4 digits only)",
        "hi": "आधार (सिर्फ़ आख़िरी 4 अंक)"
      },
      "ask": {
        "hi": "आधार नंबर के आख़िरी चार अंक बताइए।"
      },
      "readback": {
        "hi": "आधार के आख़िरी चार अंक {value} हैं।"
      }
    },
    {
      "key": "bank_account_name",
      "type": "string",
      "required": true,
      "label": {
        "en": "Name on bank passbook",
        "hi": "बैंक पासबुक पर नाम"
      },
      "ask": {
        "hi": "बैंक पासबुक पर आपका नाम कैसे लिखा है?"
      },
      "readback": {
        "hi": "पासबुक पर नाम {value} है।"
      }
    },
    {
      "key": "ifsc",
      "type": "string",
      "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$",
      "required": true,
      "label": {
        "en": "Bank IFSC",
        "hi": "बैंक IFSC कोड"
      },
      "ask": {
        "hi": "पासबुक पर लिखा IFSC कोड बताइए।"
      },
      "readback": {
        "hi": "IFSC कोड {value} है।"
      }
    },
    {
      "key": "annual_income",
      "type": "int",
      "required": true,
      "label": {
        "en": "Annual family income (₹)",
        "hi": "परिवार की सालाना आय (₹)"
      },
      "ask": {
        "hi": "पूरे परिवार की साल भर की कमाई लगभग कितनी है?"
      },
      "readback": {
        "hi": "सालाना आय {value} रुपये है।"
      }
    },
    {
      "key": "has_age_proof",
      "type": "bool",
      "required": true,
      "label": {
        "en": "Age proof document available",
        "hi": "उम्र का प्रमाण पत्र है"
      },
      "ask": {
        "hi": "क्या आपके पास उम्र का कोई प्रमाण है, जैसे आधार या वोटर कार्ड?"
      },
      "readback": {
        "hi": "उम्र का प्रमाण: {value}।"
      }
    }
  ],
  "rules": [
    {
      "id": "min_age",
      "type": "min",
      "field": "age",
      "value": 60,
      "message": {
        "hi": "आपकी उम्र {age} साल बताई गई है। पेंशन के लिए 60 साल होना ज़रूरी है। क्या उम्र सही है?"
      }
    },
    {
      "id": "name_match",
      "type": "name_match",
      "a": "name",
      "b": "bank_account_name",
      "message": {
        "hi": "आधार पर नाम {name} है, लेकिन पासबुक पर {bank_account_name}। दोनों एक जैसे होने चाहिए। कौन सा सही है?"
      }
    },
    {
      "id": "age_proof",
      "type": "must_be_true",
      "field": "has_age_proof",
      "message": {
        "hi": "उम्र के प्रमाण के बिना आवेदन रुक सकता है। क्या घर पर आधार, वोटर कार्ड या जन्म प्रमाण पत्र है?"
      }
    }
  ],
  "done": {
    "hi": "सब जानकारी पूरी है। अब मैं एक-एक करके पढ़कर सुनाऊँगी।"
  },
  "confirm": {
    "hi": "क्या सब सही है? हाँ या ना?"
  },
  "greeting": {
    "hi": "नमस्ते। मैं आपका पेंशन फ़ॉर्म भरने में मदद करूँगी।"
  },
  "not_heard": {
    "hi": "माफ़ कीजिए, ठीक से सुनाई नहीं दिया।"
  }
}
